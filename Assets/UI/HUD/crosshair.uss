.crosshair-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    position: absolute;
    width: 100%;
    height: 100%;
}

.crosshair {
    position: relative;
    transform-origin: center;
    width: 10px;
    height: 10px;
    border-radius: 100%;
    background-color: #F5F5F5;
    border-color: #000;
    border-width: 1px;
}